# NexusCompanion 环境变量示例：复制为 .env 后按需修改

# ---- 服务 ----
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# ---- 安全（生产必须修改）----
NEXUS_SECRET_KEY=please-change-me-to-a-long-random-string
NEXUS_TOKEN_EXPIRE_MINUTES=10080
# 原型开发可设为 false（免登录，默认使用第一个用户）；生产务必 true
NEXUS_AUTH_ENABLED=true

# ---- 数据库 / 向量库 ----
NEXUS_DB_PATH=./sqlite.db
NEXUS_CHROMA_PATH=./chroma_db

# ---- LLM 网关默认配置（用户级配置见 PUT /llm-config，优先级更高）----
# 留空则必须为每个用户调用 /llm-config 配置 Key
NEXUS_LLM_API_KEY=
NEXUS_LLM_BASE_URL=https://api.deepseek.com/v1
NEXUS_LLM_MODEL=deepseek-chat
NEXUS_LLM_TEMPERATURE=0.8
NEXUS_LLM_MAX_TOKENS=1024
# Ollama 本地示例：
# NEXUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NEXUS_LLM_MODEL=qwen2.5:7b
# NEXUS_LLM_API_KEY=ollama

# ---- 上下文管理 ----
# 只把最近 N 条消息以原文进入 Prompt
NEXUS_RECENT_KEEP=16
# 消息总数超过该值才在后台触发滚动摘要压缩
NEXUS_SUMMARY_THRESHOLD=30
NEXUS_RAG_TOP_K=5

# ---- 功能开关 ----
NEXUS_MEM0_ENABLED=true
# Mufy 自动写时间线前是否校验与静态人设冲突（多一次 LLM 调用）
NEXUS_CONFLICT_CHECK_ENABLED=false
